{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "testMatch": [
    "**/tests/unit-tests.ts",
    "**/tests/json-mode-and-usage.test.ts",
    "**/tests/streaming.test.ts",
    "**/tests/integration-local.ts"
  ]
}
