{
  "name": "@tanvoid0/bot-client",
  "version": "1.7.0",
  "description": "Zero-dependency TypeScript client for OpenAI, Anthropic, Gemini, Ollama, LM Studio and any OpenAI-compatible API. Real streaming, JSON mode, typed provider errors with hints, retries with backoff, static model routing. Node 18+.",
  "sideEffects": false,
  "type": "module",
  "main": "dist/cjs/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "bot-client": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs",
    "test": "jest --forceExit",
    "test:unit": "jest tests/unit-tests.ts --forceExit",
    "test:integration": "node scripts/test-integration.js",
    "test:package": "node test-package.js",
    "lint": "eslint src/**/*.ts",
    "docs": "typedoc src/index.ts --out docs",
    "clean": "node -e \"const fs=require('fs'); ['dist','docs'].forEach(d=>{try{fs.rmSync(d,{recursive:true,force:true});}catch(e){}})\"",
    "prepublishOnly": "npm run clean && npm run build && npm run test:unit",
    "publish:patch": "node scripts/publish.js patch",
    "publish:minor": "node scripts/publish.js minor",
    "publish:major": "node scripts/publish.js major",
    "publish:dry": "node scripts/publish.js dry",
    "demo:web": "npm run build && node examples/web-server-example.js",
    "demo:html": "npm run build && echo 'Open examples/react-demo.html in your browser'",
    "cli": "node dist/cli.js",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/finalize-cjs.cjs",
    "bench:overhead": "node bench/overhead.mjs",
    "bench:stream": "node --expose-gc bench/stream.mjs",
    "bench:import": "node bench/import.mjs",
    "bench:size": "node bench/size.mjs",
    "bench": "npm run bench:overhead && npm run bench:stream && npm run bench:stream -- --size && npm run bench:import && npm run bench:size"
  },
  "keywords": [
    "ai",
    "llm",
    "llm-client",
    "ai-sdk",
    "unified-llm-api",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "ollama",
    "lmstudio",
    "openai-compatible",
    "streaming",
    "json-mode",
    "zero-dependency",
    "typescript",
    "chatgpt",
    "machine-learning"
  ],
  "author": "tanvoid0",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.0.0",
    "express": "^5.1.0",
    "jest": "^29.5.0",
    "react": "^19.1.1",
    "ts-jest": "^29.1.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanvoid0/bot-client.git"
  },
  "bugs": {
    "url": "https://github.com/tanvoid0/bot-client/issues"
  },
  "homepage": "https://github.com/tanvoid0/bot-client#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "module": "dist/index.js",
  "overrides": {
    "minimatch@9": "^9.0.7"
  }
}
